<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Gem Views",
    subtitle: "These are the view templates currently shipped by the gem.",
    variant: :h1
  ) %>

  <%= render FlatPack::List::Component.new(divider: true) do %>
    <% Array(@engine_views).each do |view_path| %>
      <%= render FlatPack::List::Item.new(icon: :eye) { view_path } %>
    <% end %>
  <% end %>
</div>
